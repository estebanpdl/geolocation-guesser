# Google Maps JavaScript API + Street View for the browser.
# NEXT_PUBLIC_ makes it public by design: restrict it to your site's origins and to the Maps JavaScript API.
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here

# Server-only key for the Street View Static API (scene analysis). Use a separate, server-restricted key.
# If unset, the public key above is used as a fallback.
GOOGLE_MAPS_API_KEY=your_google_maps_server_key_here

# Gemini Vision API key (server-side only — never expose to client)
GOOGLE_GENERATIVE_AI_KEY=your_gemini_api_key_here

# Server keys can instead be saved outside the repository with `npm run auth -- set <gemini|maps-server>`,
# in ~/.geolocation-guesser/credentials.json under the server account's home directory (on Windows,
# %USERPROFILE%\.geolocation-guesser\credentials.json).
# A nonempty value in this file (or the server's environment) overrides the saved one, except that a
# saved `closed` training mode always wins. `npm run auth -- status` reads these files too and reports
# what is configured without printing values. To use another location, set an absolute path:
# GEOLOCATION_GUESSER_CREDENTIALS_FILE=

# Training access for public sessions (also manageable with `npm run auth -- training ...`):
#   off    - local use; AI analysis needs no access code (default)
#   open   - AI analysis requires the access code, entered at /training
#   closed - AI analysis is blocked for everyone
# Participants use the server's keys and the app sets no usage limits; set spend limits with your providers.
# Sessions live in server memory: restarting ends them, and only one server process is supported.
# Rotating the code ends existing sessions. The code is case-insensitive and needs at least 8 characters.
# TRAINING_MODE=off
# TRAINING_ACCESS_CODE=your_training_access_code_here
# TRAINING_SESSION_TTL_MINUTES=180
