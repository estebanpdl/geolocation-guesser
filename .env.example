# Google Maps JavaScript API + Street View API (billing-enabled key)
# NEXT_PUBLIC_ makes it available client-side (Maps JS API needs it in the browser).
# GOOGLE_MAPS_API_KEY is the same value, used server-side (Street View Static API for AI analysis).
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here
GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here

# Gemini Vision API key (server-side only — never expose to client)
GOOGLE_GENERATIVE_AI_KEY=your_gemini_api_key_here
